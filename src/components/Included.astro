---
// "What's included" list for the service pages.
// items: [{ t: 'Title', d: 'Description' }]
const { heading = 'What’s included', intro, items = [] } = Astro.props;
---
<section class="wrap section included">
  <div class="section-head">
    <h2 class="h2">{heading}</h2>
    {intro && <p>{intro}</p>}
  </div>
  <ul class="inc-list">
    {items.map((i) => (
      <li>
        <h3>{i.t}</h3>
        <p>{i.d}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .included { padding-top: clamp(32px, 4vw, 56px); }
  .inc-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 0 var(--col-gap);
  }
  .inc-list li { border-top: 1px solid var(--rule); padding: 20px 0 24px; }
  .inc-list h3 { margin: 0 0 6px; font-family: var(--serif); font-weight: 400; font-size: 26px; line-height: 1.15; }
  .inc-list p { margin: 0; color: var(--body-2); font-size: 17px; }
</style>
