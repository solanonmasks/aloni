---
// Masonry photo gallery with optional filter chips and a lightbox.
// Props:
//   heading     – section title
//   items       – gallery entries (defaults to all)
//   filters     – show the All / Bathrooms / Kitchens / Living chips
//   moreLink    – optional { href, label } shown under the photos
import { gallery, wix } from '../data/site.js';
import Img from './Img.astro';

const { id = 'work', heading = 'Recent work', items = gallery, filters = true, moreLink } = Astro.props;
const FILTERS = [
  { label: 'All', cat: 'all' },
  { label: 'Bathrooms', cat: 'Bath' },
  { label: 'Kitchens', cat: 'Kitchen' },
  { label: 'Living', cat: 'Living' },
];
const big = (g) => {
  const [a, b] = g.ratio.split('/').map(Number);
  return wix(g.id, 1600, Math.round((1600 * b) / a), g.ext);
};
---
<section id={id} class="bg-stone" data-gallery>
  <div class="wrap section">
    <div class="section-head gallery-head">
      <h2 class="h2">{heading}</h2>
      {filters && (
        <div class="chips" role="group" aria-label="Filter photos">
          {FILTERS.map((f, i) => (
            <button type="button" class="chip" data-filter={f.cat} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
          ))}
        </div>
      )}
    </div>
    <ul class="masonry">
      {items.map((g) => (
        <li data-cat={g.cat}>
          <button type="button" class="tile" data-big={big(g)} data-alt={g.alt} aria-label={`Open photo: ${g.alt}`}>
            <Img id={g.id} ext={g.ext} ratio={g.ratio} alt={g.alt} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 25vw" />
          </button>
        </li>
      ))}
    </ul>
    {moreLink && <p class="more"><a href={moreLink.href}>{moreLink.label}</a></p>}
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img class="lb-img" alt="" />
    <button type="button" class="lb-btn lb-prev" aria-label="Previous photo">‹</button>
    <button type="button" class="lb-btn lb-next" aria-label="Next photo">›</button>
    <button type="button" class="lb-btn lb-close" aria-label="Close">×</button>
  </dialog>
</section>

<style>
  .gallery-head { margin-bottom: 36px; }
  .masonry { list-style: none; margin: 0; padding: 0; column-width: 300px; column-gap: 16px; }
  .masonry li { break-inside: avoid; margin: 0 0 16px; }
  .masonry li[hidden] { display: none; }
  .tile { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: 4px; }
  .tile:hover :global(img) { opacity: .92; }
  .more { margin: 24px 0 0; font-weight: 600; }

  .lightbox {
    width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 24px;
    border: 0; background: rgba(30, 28, 25, .94); cursor: zoom-out;
  }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox::backdrop { background: transparent; }
  .lb-img { max-width: 100%; max-height: 90vh; object-fit: contain; border-radius: 4px; display: block; }
  .lb-btn {
    position: absolute; width: 52px; height: 52px; border-radius: 999px; border: 0;
    background: rgba(238, 234, 227, .14); color: var(--limestone); font-size: 34px; line-height: 1;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
  }
  .lb-btn:hover { background: rgba(238, 234, 227, .28); }
  .lb-prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 16px; top: 50%; transform: translateY(-50%); }
  .lb-close { right: 16px; top: 16px; }
</style>

<script>
  document.querySelectorAll('[data-gallery]').forEach((root) => {
    const items = [...root.querySelectorAll('.masonry li')];
    const chips = root.querySelectorAll('[data-filter]');
    const dialog = root.querySelector('.lightbox');
    const big = dialog.querySelector('.lb-img');
    let visible = items;
    let index = 0;
    let opener = null;

    // Filter chips
    chips.forEach((chip) => chip.addEventListener('click', () => {
      const cat = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      items.forEach((li) => { li.hidden = cat !== 'all' && li.dataset.cat !== cat; });
      visible = items.filter((li) => !li.hidden);
    }));

    // Lightbox
    function show(i) {
      index = (i + visible.length) % visible.length;
      const tile = visible[index].querySelector('.tile');
      big.src = tile.dataset.big;
      big.alt = tile.dataset.alt;
    }
    items.forEach((li) => li.querySelector('.tile').addEventListener('click', (e) => {
      opener = e.currentTarget;
      show(visible.indexOf(li));
      dialog.showModal();
    }));
    dialog.querySelector('.lb-prev').addEventListener('click', (e) => { e.stopPropagation(); show(index - 1); });
    dialog.querySelector('.lb-next').addEventListener('click', (e) => { e.stopPropagation(); show(index + 1); });
    dialog.querySelector('.lb-close').addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (!e.target.closest('.lb-prev, .lb-next')) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // Esc closes the dialog on its own; return focus to the photo that opened it.
    dialog.addEventListener('close', () => { opener?.focus(); });
  });
</script>
